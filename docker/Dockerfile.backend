# syntax=docker/dockerfile:1.7

# ==========================================================
# Stage 1: Compile the Tutor MCP binary from source
# ==========================================================
FROM golang:1.26-alpine AS tutor-builder

# git is required to clone the repo
RUN apk add --no-cache git

# Allow Go to auto-download a matching toolchain if go.mod requires newer
ENV GOTOOLCHAIN=auto

WORKDIR /src
RUN git clone --depth 1 https://github.com/ArnaudGuiovanna/tutor-mcp.git .

# Build a static Linux binary compatible with the target platform
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/tutor-mcp .

# ==========================================================
# Stage 2: Python backend
# ==========================================================
FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    sqlite3 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Copy the compiled Tutor MCP binary from the builder stage
COPY --from=tutor-builder /out/tutor-mcp /usr/local/bin/tutor-mcp
RUN chmod +x /usr/local/bin/tutor-mcp

# Create application data directories
RUN mkdir -p \
    /app/data/university_docs \
    /app/data/vector_store \
    /app/data/tutor-mcp

# Add wait-for-ollama script
# Normalize line endings (CRLF -> LF) and make executable
COPY docker/wait-for-ollama.sh /wait-for-ollama.sh
RUN sed -i 's/\r$//' /wait-for-ollama.sh \
    && chmod +x /wait-for-ollama.sh

# Default command: run tests.
# Docker Compose overrides this to start the application.
CMD ["/wait-for-ollama.sh", "pytest", "tests/", "-v"]