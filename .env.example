OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=llama3.2

# ============================================================
# OLLAMA SERVER
# ============================================================

OLLAMA_HOST=http://ollama:11434
OLLAMA_TIMEOUT=900
TRANSCRIPT_CHUNK_SIZE=2200
OLLAMA_MAX_RETRIES=2
# ============================================================
# MODEL PROFILE
# Choose ONE MODEL_ID for the target machine
# ============================================================

# Windows / Mac, 8 GB RAM
MODEL_ID=llama3.2:3b

# Windows / Mac, 16 GB RAM
# MODEL_ID=qwen2.5:7b

# MacBook M1 Pro, 32 GB unified memory
# MODEL_ID=qwen2.5:14b

# MacBook / workstation, 64 GB+
# Test a larger quantized model when needed.

# ============================================================
# APPLICATION
# ============================================================
TELEGRAM_BOT_TOKEN=your_token_here
ICAL_URL=
HOURS_PER_DAY=2
BUFFER_DAYS=1
REMINDER_TIME=09:00
DATABASE_URL=sqlite:///./data/student_context.db
API_PORT=8000



# ============================================================
# MODEL PROFILE — CHOOSE ONE MODEL_ID FOR THE TARGET MACHINE
# ============================================================

# ------------------------------------------------------------
# WINDOWS / MAC — 8 GB RAM
# Best for lightweight assistants and simple tasks
# ------------------------------------------------------------
# MODEL_ID=llama3.2:1b          # Very lightweight chat (~1.3GB)
# MODEL_ID=llama3.2:3b            # General assistant (~2GB)
# MODEL_ID=qwen2.5:3b           # Multilingual, instruction following (~1.9GB)
# MODEL_ID=qwen2.5-coder:3b     # Coding and debugging (~1.9GB)
# MODEL_ID=deepseek-r1:1.5b     # Lightweight reasoning (~1.1GB)
# MODEL_ID=deepseek-coder:1.3b  # Lightweight coding (~0.8GB)


# ------------------------------------------------------------
# WINDOWS / MAC — 16 GB RAM
# Best balance between speed and capability
# ------------------------------------------------------------
# MODEL_ID=qwen2.5:7b           # General assistant (~4.7GB)
# MODEL_ID=llama3.1:8b          # General chat (~4.9GB)
# MODEL_ID=qwen2.5-coder:7b     # Coding and debugging (~4.7GB)
# MODEL_ID=deepseek-r1:8b       # Reasoning and problem solving (~5.2GB)
# MODEL_ID=deepseek-coder:6.7b  # Code-focused model (~3.8GB)
# MODEL_ID=gemma3:4b            # General chat and vision (~3.3GB)


# ------------------------------------------------------------
# MACBOOK M1 / M1 PRO — 16 GB UNIFIED MEMORY
# Recommended for everyday local AI applications
# ------------------------------------------------------------
# MODEL_ID=qwen2.5:7b           # General assistant
# MODEL_ID=qwen2.5-coder:7b     # Coding agent
# MODEL_ID=deepseek-r1:8b       # Reasoning agent
# MODEL_ID=gemma3:4b            # General chat and vision


# ------------------------------------------------------------
# MACBOOK M1 PRO / WINDOWS — 32 GB RAM
# Good for more capable reasoning and coding models
# ------------------------------------------------------------
# MODEL_ID=qwen2.5:14b             # General assistant (~9GB)
# MODEL_ID=deepseek-r1:14b       # Advanced reasoning (~9GB)
# MODEL_ID=qwen2.5-coder:14b    # Coding and software development (~9GB)
# MODEL_ID=gemma3:12b            # General chat and vision (~8GB)
# MODEL_ID=qwen2.5:32b          # Larger general model (~20GB)
# MODEL_ID=qwen2.5-coder:32b    # Advanced coding (~20GB; tight on 32GB)
# MODEL_ID=deepseek-r1:32b      # Advanced reasoning (~20GB; tight on 32GB)


# ------------------------------------------------------------
# MACBOOK / WINDOWS — 64 GB RAM OR UNIFIED MEMORY
# Suitable for larger quantized models
# ------------------------------------------------------------
# MODEL_ID=qwen2.5:14b          # Faster general assistant (~9GB)
# MODEL_ID=qwen2.5:32b          # Larger general assistant (~20GB)
# MODEL_ID=qwen2.5-coder:32b    # Advanced coding (~20GB)
# MODEL_ID=deepseek-r1:32b      # Advanced reasoning (~20GB)
# MODEL_ID=qwen2.5:72b          # Large general model (~47GB; tight)
# MODEL_ID=deepseek-r1:70b      # Large reasoning model (~43GB; tight)


# ------------------------------------------------------------
# WINDOWS — NVIDIA GPU, 4 GB VRAM
# ------------------------------------------------------------
# MODEL_ID=llama3.2:3b
# MODEL_ID=qwen2.5-coder:3b


# ------------------------------------------------------------
# WINDOWS — NVIDIA GPU, 6–8 GB VRAM
# ------------------------------------------------------------
# MODEL_ID=qwen2.5:7b
# MODEL_ID=qwen2.5-coder:7b
# MODEL_ID=deepseek-r1:8b


# ------------------------------------------------------------
# WINDOWS — NVIDIA GPU, 12–16 GB VRAM
# ------------------------------------------------------------
# MODEL_ID=qwen2.5:14b
# MODEL_ID=qwen2.5-coder:14b
# MODEL_ID=deepseek-r1:14b


# ------------------------------------------------------------
# WINDOWS — NVIDIA GPU, 24 GB VRAM
# ------------------------------------------------------------
# MODEL_ID=qwen2.5-coder:32b
# MODEL_ID=deepseek-r1:32b


# ------------------------------------------------------------
# WINDOWS / WORKSTATION — NVIDIA GPU, 48 GB+ VRAM
# ------------------------------------------------------------
# MODEL_ID=qwen2.5:72b
# MODEL_ID=deepseek-r1:70b


# ============================================================
# EMBEDDING MODELS — FOR RAG AND DOCUMENT SEARCH
# Configure separately from MODEL_ID
# ============================================================
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_MODEL=nomic-embed-text


# ============================================================
# SPECIALIST MODEL SELECTION
# Uncomment the appropriate MODEL_ID above.
#
# General assistant  -> qwen2.5:7b or qwen2.5:14b
# Coding             -> qwen2.5-coder:7b or qwen2.5-coder:14b
# Advanced coding    -> qwen2.5-coder:32b
# Reasoning          -> deepseek-r1:8b or deepseek-r1:14b
# Advanced reasoning -> deepseek-r1:32b
# Vision             -> gemma3:4b or gemma3:12b
# Document retrieval -> bge-m3 or nomic-embed-text
#
# Model file sizes are approximate. Actual RAM/VRAM needs
# depend on quantization, context length and runtime overhead.
# ============================================================
